+}
+
+/// First allow the selected source and its contained aliases to move over their
+/// own old rows; every unrelated snapshot and every live lane remains reserved.
+/// If that cannot fit and no lanes are live, compact disjoint retained groups in
+/// their existing order, expanding the source group's reservation for this request.
+pub fn restore(gpa: Allocator, cap: usize, alignment: usize, live: []const Range,
+    snapshots: []const Range, source: Range, size: usize) !?Plan
+{
+    if (source.lo >= source.hi or source.hi > cap or size < source.hi - source.lo or size > cap)
+        return error.BadLayout;
+    var used: std.ArrayList(Range) = .empty;
+    defer used.deinit(gpa);
+    try used.appendSlice(gpa, live);
+    for (snapshots) |r| if (!source.contains(r)) try used.append(gpa, r);
+    if (gap(used.items, size, cap, alignment)) |base| {
+        var p: Plan = .{ .base = base };
+        errdefer p.deinit(gpa);
+        if (base != source.lo) try p.moves.append(gpa, .{ .from = source.lo, .to = base, .len = source.hi - source.lo });
+        return p;
+    }
+    // Active lane coordinates never change here. Wait/legacy capacity handling
+    // remains responsible for layouts that require moving live data.
+    if (live.len != 0) return null;
+    var groups: std.ArrayList(Range) = .empty;
+    defer groups.deinit(gpa);
+    try groups.appendSlice(gpa, snapshots);
+    std.mem.sort(Range, groups.items, {}, Range.less);
+    var n: usize = 0;
+    for (groups.items) |r| {
+        if (n > 0 and r.lo < groups.items[n - 1].hi) {
+            groups.items[n - 1].hi = @max(groups.items[n - 1].hi, r.hi);
+        } else {
+            groups.items[n] = r;
+            n += 1;
+        }
+    }
+    groups.items.len = n;
+    const source_index = for (groups.items, 0..) |r, i| {
+        if (r.lo == source.lo and r.hi == source.hi) break i;
+    } else return null; // a longer fork overlaps the source: it cannot be expanded in place
+
+    var proposed: std.ArrayList(Move) = .empty;
+    defer proposed.deinit(gpa);
+    var cursor: usize = 0;
+    var base: usize = 0;
+    for (groups.items, 0..) |r, i| {
+        const reserved = if (i == source_index) size else r.hi - r.lo;
+        cursor = std.mem.alignForward(usize, cursor, alignment);
+        if (cursor > cap or reserved > cap - cursor) return null;
+        if (i == source_index) base = cursor;
+        try proposed.append(gpa, .{ .from = r.lo, .to = cursor, .len = r.hi - r.lo });
+        cursor += reserved;
+    }
+    var p: Plan = .{ .base = base, .compacted = true };
+    errdefer p.deinit(gpa);
+    // Order-preserving layout: left moves from low to high, right moves from high
+    // to low. A copy must not destroy the original rows of a group not yet moved.
+    for (proposed.items) |m| if (m.to < m.from) try p.moves.append(gpa, m);
+    var i = proposed.items.len;
+    while (i > 0) {
+        i -= 1;
+        const m = proposed.items[i];
+        if (m.to > m.from) try p.moves.append(gpa, m);
+    }
+    return p;
+}
+
+/// CUDA memcpy calls must have disjoint source/destination ranges. Splitting an
+/// overlapping move into displacement-sized pieces gives memmove semantics when
+/// queued in order on the SAME stream, without extra GPU allocation.
+pub const CopyParts = struct {
+    from: usize,
+    to: usize,
+    len: usize,
+    left: usize,
+
+    pub fn init(from: usize, to: usize, len: usize) CopyParts {
+        return .{ .from = from, .to = to, .len = len, .left = if (from == to) 0 else len };
+    }
+
+    pub fn next(p: *CopyParts) ?Move {
+        if (p.left == 0) return null;
+        const distance = @max(p.from, p.to) - @min(p.from, p.to);
+        const len = @min(p.left, distance);
+        const offset = if (p.to > p.from) p.left - len else p.len - p.left;
+        p.left -= len;
+        return .{ .from = p.from + offset, .to = p.to + offset, .len = len };
+    }
+};
+
+test "copy parts preserve exact data for both overlapping directions and disjoint copies" {
