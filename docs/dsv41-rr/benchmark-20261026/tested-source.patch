+    try std.testing.expect((try oldestGroup(gpa, saved[0..2], &.{.{ .lo = 0, .hi = 2 }})) == null);
+}
+
+test "exhaustive cold placement preserves data and admits every fitting aligned two-group layout" {
+    const gpa = std.testing.allocator;
+    for (0..9) |a0| for (1..7) |alen| for (0..17) |b0| for (1..7) |blen| {
+        const a: Range = .{ .lo = a0, .hi = a0 + alen };
+        const b: Range = .{ .lo = b0, .hi = b0 + blen };
+        if (a.overlaps(b)) continue;
