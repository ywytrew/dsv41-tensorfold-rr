+test "physical group recency protects hot aliases and pinned source" {
+    const gpa = std.testing.allocator;
+    const saved = [_]Retained{
+        .{ .range = .{ .lo = 0, .hi = 2 }, .used = 1 },
+        .{ .range = .{ .lo = 0, .hi = 8 }, .used = 100 },
