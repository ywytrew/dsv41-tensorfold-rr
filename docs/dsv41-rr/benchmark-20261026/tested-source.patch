+        for (&actual, 0..) |*v, i| v.* = @intCast(i * 97 + 13);
+        var expected = actual;
+        const original = actual;
+        @memcpy(expected[to..][0..len], original[from..][0..len]);
+        var parts = CopyParts.init(from, to, len);
+        while (parts.next()) |m| {
+            try std.testing.expect(m.from + m.len <= m.to or m.to + m.len <= m.from);
+            @memcpy(actual[m.to..][0..m.len], actual[m.from..][0..m.len]);
+        }
+        try std.testing.expectEqualSlices(u32, &expected, &actual);
+    };
+}
