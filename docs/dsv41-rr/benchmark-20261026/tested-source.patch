+    defer p.deinit(std.testing.allocator);
+    try std.testing.expect(!p.compacted);
+    try std.testing.expectEqual(@as(usize, 188416), p.base);
+    try std.testing.expectEqual(p.base, p.relocated(older));
+    try std.testing.expectEqual(@as(usize, 0), p.relocated(b));
+}
+
+test "layout leaves live lanes and longer fork data reserved; real capacity shortages remain explicit" {
+    const a: Range = .{ .lo = 0, .hi = 8 };
+    const fork: Range = .{ .lo = 0, .hi = 12 };
+    const b: Range = .{ .lo = 8, .hi = 16 };
+    try std.testing.expect((try restore(std.testing.allocator, 20, 1, &.{b}, &.{ a, b }, a, 12)) == null);
+    try std.testing.expect((try restore(std.testing.allocator, 20, 1, &.{}, &.{ a, fork }, a, 12)) == null);
+    try std.testing.expect((try restore(std.testing.allocator, 18, 1, &.{}, &.{ a, b }, a, 12)) == null);
+}
+
+test "exhaustive small two-branch layouts preserve every retained token and aliases through expansion" {
+    const gpa = std.testing.allocator;
+    for (0..9) |a0| for (1..9) |alen| for (0..17) |b0| for (1..9) |blen| {
+        const a: Range = .{ .lo = a0, .hi = a0 + alen };
+        const b: Range = .{ .lo = b0, .hi = b0 + blen };
+        if (a.overlaps(b)) continue;
+        for (alen..17) |size| {
+            if (size + blen > 32) continue;
+            const alias: Range = .{ .lo = a.lo, .hi = a.lo + 1 };
+            var p = (try restore(gpa, 32, 1, &.{}, &.{ a, b, alias }, a, size)).?;
+            defer p.deinit(gpa);
+            var memory: [32]u32 = undefined;
+            for (&memory, 0..) |*v, i| v.* = @intCast(i + 100);
+            const original = memory;
+            for (p.moves.items) |move| {
+                var parts = CopyParts.init(move.from, move.to, move.len);
+                while (parts.next()) |m| @memcpy(memory[m.to..][0..m.len], memory[m.from..][0..m.len]);
+            }
+            for ([_]Range{ a, b, alias }) |r| {
+                const base = p.relocated(r);
+                try std.testing.expectEqualSlices(u32, original[r.lo..r.hi], memory[base..][0 .. r.hi - r.lo]);
+            }
+            try std.testing.expect(!(Range{ .lo = p.base, .hi = p.base + size }).overlaps(
+                .{ .lo = p.relocated(b), .hi = p.relocated(b) + blen }));
+        }
+    };
+}
+
+test "three retained groups survive mixed-direction compaction with exact contents" {
+    const gpa = std.testing.allocator;
+    var seed: u64 = 0x815673;
+    for (0..6000) |iteration| {
+        var ranges: [3]Range = undefined;
+        var end: usize = 0;
+        var total: usize = 0;
+        for (&ranges) |*r| {
+            seed = seed *% 6364136223846793005 +% 1442695040888963407;
+            const gap_: usize = @intCast((seed >> 32) % 3);
+            const len: usize = 1 + @as(usize, @intCast((seed >> 16) % 5));
+            r.* = .{ .lo = end + gap_, .hi = end + gap_ + len };
+            end = r.hi;
+            total += len;
+        }
+        const source_index = iteration % 3;
+        const source = ranges[source_index];
+        const maximum = 32 - (total - (source.hi - source.lo));
+        const size = source.hi - source.lo + iteration % (maximum - (source.hi - source.lo) + 1);
+        var plan = (try restore(gpa, 32, 1, &.{}, &ranges, source, size)).?;
+        defer plan.deinit(gpa);
+        var memory: [32]u32 = undefined;
+        for (&memory, 0..) |*v, i| v.* = @intCast(i * 71 + iteration);
+        const original = memory;
+        for (plan.moves.items) |m| {
+            var parts = CopyParts.init(m.from, m.to, m.len);
+            while (parts.next()) |part|
+                @memcpy(memory[part.to..][0..part.len], memory[part.from..][0..part.len]);
+        }
+        for (ranges, 0..) |r, i| {
+            const base = plan.relocated(r);
+            try std.testing.expectEqualSlices(u32, original[r.lo..r.hi], memory[base..][0 .. r.hi - r.lo]);
+            if (i != source_index) try std.testing.expect(!(Range{ .lo = plan.base, .hi = plan.base + size }).overlaps(
+                .{ .lo = base, .hi = base + r.hi - r.lo }));
+        }
+    }
+}
+
+test "overlapping source relocation never writes an active B reservation" {
+    const a: Range = .{ .lo = 24, .hi = 32 };
+    const b: Range = .{ .lo = 8, .hi = 16 };
+    var p = (try restore(std.testing.allocator, 32, 1, &.{b}, &.{ a, b }, a, 12)).?;
+    defer p.deinit(std.testing.allocator);
+    try std.testing.expectEqual(@as(usize, 16), p.base);
+    try std.testing.expectEqual(@as(usize, 8), p.relocated(b));
+    for (p.moves.items) |m| try std.testing.expect(!b.overlaps(.{ .lo = m.to, .hi = m.to + m.len }));
+}
