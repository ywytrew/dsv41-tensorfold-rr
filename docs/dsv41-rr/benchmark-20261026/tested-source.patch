+test "GC waits above 85 percent, starts exactly at 90, stops at 70, preserves two branches" {
+    const gpa = std.testing.allocator;
+    var f: Fake = .{ .gpa = gpa };
+    var s = Store.init(gpa, f.gcSnapshots(), .{ .gc = true, .min_prompt = 0 }, 1100);
+    defer s.deinit();
+    for (1..10) |id| {
+        const p = [_]u32{ @intCast(id), 2, 3, 4, 5, 9 };
+        try keepGc(&f, &s, &p, 5); // 9 x 105 = 945: 85.9%, must not trigger the old 85% rule
+    }
+    s.maintain(&.{ 9, 2, 3, 4, 5, 9 }, &.{});
+    try std.testing.expectEqual(@as(u64, 0), s.counts.gc_runs);
+    try std.testing.expectEqual(@as(u64, 945), s.held);
+    // Revisit branch 1; oldest-created does not mean least-recently-used.
+    const a = s.find(&.{ 1, 2, 3, 4, 5, 9 }, &.{}, &.{}).?;
+    s.resumed(a, &.{ 1, 2, 3, 4, 5, 9 }, true);
+    s.budget = 1050; // same contents exactly at 90%; the 70% target is 735 bytes
+    s.maintain(&.{ 9, 2, 3, 4, 5, 9 }, &.{});
+    try std.testing.expectEqual(@as(u64, 1), s.counts.gc_runs);
+    try std.testing.expectEqual(@as(u64, 2), s.counts.gc_evicted);
+    try std.testing.expectEqual(@as(u64, 735), s.held);
+    try std.testing.expect(s.find(&.{ 1, 2, 3, 4, 5, 9 }, &.{}, &.{}) != null);
+    try std.testing.expect(s.find(&.{ 9, 2, 3, 4, 5, 9 }, &.{}, &.{}) != null);
