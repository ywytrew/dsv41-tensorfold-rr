+// Cache maintenance modifications, ywytrew, 2026-10-26. Apache-2.0; see NOTICE.
+//! Restore placement without requiring a second full copy of the source extent.
+//! Pure host planning: no cache eviction or pointer mutation until copies succeed.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+pub const Range = struct {
+    lo: usize,
+    hi: usize,
+    pub fn contains(a: Range, b: Range) bool {
+        return a.lo <= b.lo and b.hi <= a.hi;
+    }
+    pub fn overlaps(a: Range, b: Range) bool {
+        return a.lo < b.hi and b.lo < a.hi;
+    }
+    fn less(_: void, a: Range, b: Range) bool {
+        return a.lo < b.lo or (a.lo == b.lo and a.hi < b.hi);
+    }
+};
+
+pub const Move = struct { from: usize, to: usize, len: usize };
+pub const Plan = struct {
+    base: usize,
+    compacted: bool = false,
+    moves: std.ArrayList(Move) = .empty,
+
+    pub fn deinit(p: *Plan, gpa: Allocator) void {
+        p.moves.deinit(gpa);
+    }
+
+    /// Called against original snapshot coordinates, only after ALL moves succeed.
+    pub fn relocated(p: *const Plan, r: Range) usize {
+        for (p.moves.items) |m| {
+            if ((Range{ .lo = m.from, .hi = m.from + m.len }).contains(r))
+                return m.to + (r.lo - m.from);
+        }
+        return r.lo;
+    }
+};
+
+fn gap(used: []const Range, size: usize, cap: usize, alignment: usize) ?usize {
+    if (size > cap) return null;
+    var base: usize = 0;
+    while (base <= cap - size) {
+        var past: ?usize = null;
+        for (used) |r| if (r.overlaps(.{ .lo = base, .hi = base + size })) {
+            past = @max(past orelse 0, r.hi);
+        };
+        if (past) |n| base = std.mem.alignForward(usize, n, alignment) else return base;
+    }
+    return null;
+}
+
+/// Cold admission gets the same preservation guarantee as restore: use a gap,
+/// or compact idle extents before considering eviction. Active coordinates never
+/// move. Null with active lanes means wait for them, not discard their neighbors.
+pub fn allocate(gpa: Allocator, cap: usize, alignment: usize, live: []const Range, snapshots: []const Range, size: usize) !?Plan {
+    if (size > cap) return null;
+    var used: std.ArrayList(Range) = .empty;
+    defer used.deinit(gpa);
+    try used.appendSlice(gpa, live);
+    try used.appendSlice(gpa, snapshots);
+    if (gap(used.items, size, cap, alignment)) |base| return .{ .base = base };
+    if (live.len != 0) return null;
+    std.mem.sort(Range, used.items, {}, Range.less);
+    var n: usize = 0;
+    for (used.items) |r| {
+        if (r.lo >= r.hi or r.hi > cap or r.lo % alignment != 0 or r.hi % alignment != 0) return error.BadLayout;
+        if (n > 0 and r.lo < used.items[n - 1].hi) {
+            used.items[n - 1].hi = @max(used.items[n - 1].hi, r.hi);
+        } else {
+            used.items[n] = r;
+            n += 1;
+        }
+    }
+    var p: Plan = .{ .base = 0, .compacted = true };
+    errdefer p.deinit(gpa);
+    var cursor: usize = 0;
+    for (used.items[0..n]) |r| {
+        cursor = std.mem.alignForward(usize, cursor, alignment);
+        const len = r.hi - r.lo;
+        if (cursor > cap or len > cap - cursor) {
+            p.deinit(gpa);
+            return null;
+        }
+        // Sorted groups compact left, so executing in this order preserves all
+        // yet-to-be-moved source rows. CopyParts handles an individual overlap.
+        if (cursor != r.lo) try p.moves.append(gpa, .{ .from = r.lo, .to = cursor, .len = len });
+        cursor += len;
+    }
+    cursor = std.mem.alignForward(usize, cursor, alignment);
+    if (cursor > cap or size > cap - cursor) {
+        p.deinit(gpa);
+        return null;
+    }
+    p.base = cursor;
+    return p;
+}
+
+pub const Retained = struct { range: Range, used: u64 };
+
+/// Alias checkpoints share physical rows. Their group is as recent as its most
+/// recently used member; deleting an old alias alone does not free those rows.
+pub fn oldestGroup(gpa: Allocator, snapshots: []const Retained, pinned: []const Range) !?Range {
+    const groups = try gpa.dupe(Retained, snapshots);
+    defer gpa.free(groups);
+    std.mem.sort(Retained, groups, {}, struct {
+        fn less(_: void, a: Retained, b: Retained) bool {
+            return Range.less({}, a.range, b.range);
+        }
+    }.less);
+    var n: usize = 0;
+    for (groups) |r| {
+        if (n > 0 and r.range.lo < groups[n - 1].range.hi) {
+            groups[n - 1].range.hi = @max(groups[n - 1].range.hi, r.range.hi);
+            groups[n - 1].used = @max(groups[n - 1].used, r.used);
+        } else {
+            groups[n] = r;
+            n += 1;
+        }
+    }
+    var best: ?Retained = null;
+    for (groups[0..n]) |r| {
+        const protected = for (pinned) |p| {
+            if (p.overlaps(r.range)) break true;
+        } else false;
+        if (!protected and (best == null or r.used < best.?.used)) best = r;
+    }
+    return if (best) |r| r.range else null;
+}
+
